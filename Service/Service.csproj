<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <RootNamespace>OSDC.Drilling.EarthGravity.Service</RootNamespace>
    <Authors>Eric Cayeux</Authors>
    <Company>NORCE Research</Company>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <SwaggerCliVersion>9.0.3</SwaggerCliVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.31" />
    <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.29" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="$(SwaggerCliVersion)" />
    <ProjectReference Include="..\Model\Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\GravityModelFiles\**\*">
      <Link>GravityModelFiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CreateSwaggerJson" AfterTargets="Build" DependsOnTargets="ExportSwaggerJson" Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'" />
  <Target Name="ExportSwaggerJson">
    <PropertyGroup>
      <!-- Match the service runtime, not the SDK used to restore the local tool. -->
      <SwaggerCliPath>$(NuGetPackageRoot)swashbuckle.aspnetcore.cli/$(SwaggerCliVersion)/tools/$(TargetFramework)/any/dotnet-swagger.dll</SwaggerCliPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(SwaggerCliPath)')" Text="Swagger CLI $(SwaggerCliVersion) for $(TargetFramework) is missing. Run 'dotnet tool restore' from the EarthGravity repository root, then rebuild." />
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\ModelSharedOut\json-schemas" />
    <Exec Command="dotnet &quot;$(SwaggerCliPath)&quot; tofile --output &quot;$(MSBuildProjectDirectory)/../ModelSharedOut/json-schemas/EarthGravityFullName.json&quot; &quot;$(TargetPath)&quot; v1" WorkingDirectory="$(ProjectDir)" />
  </Target>
</Project>
